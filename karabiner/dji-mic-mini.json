{
  "title": "SpeekCoding push-to-talk",
  "rules": [
    {
      "description": "SpeekCoding: Fn or DJI Mic Mini toggles native dictation",
      "manipulators": [
        {
          "from": {
            "key_code": "fn"
          },
          "to": [
            {
              "key_code": "fn",
              "lazy": true
            }
          ],
          "to_if_alone": [
            {
              "shell_command": "~/.config/karabiner/scripts/speek-command toggle fn"
            }
          ],
          "type": "basic"
        },
        {
          "conditions": [
            {
              "identifiers": [
                {
                  "is_consumer": true,
                  "product_id": 16401,
                  "vendor_id": 11427
                }
              ],
              "type": "device_if"
            }
          ],
          "from": {
            "consumer_key_code": "volume_increment",
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "vk_none"
            },
            {
              "shell_command": "~/.config/karabiner/scripts/speek-command toggle dji"
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
